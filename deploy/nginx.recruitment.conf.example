# Recruitment Agent — 独立域名 HTTPS 反代模板（Nginx）
# 关键点：/recruitment/agent/turn 为 SSE 流式接口，必须关闭 proxy_buffering。
server {
    listen 443 ssl http2;
    server_name hiring.example.com;

    ssl_certificate     /etc/nginx/certs/hiring.example.com.pem;
    ssl_certificate_key /etc/nginx/certs/hiring.example.com.key;

    client_max_body_size 25m;

    # SSE 对话流：关闭缓冲与超时压缩，确保首字延迟（TTFT）稳定
    location = /recruitment/agent/turn {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
    }

    location /recruitment/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
