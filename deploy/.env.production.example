# Recruitment Agent 生产环境变量模板（复制为 .env.production 后填入真实值，切勿提交到 Git）

# 1. 认证与安全模式（生产环境必须设为 production，自动关闭 /recruitment/test 与 preview alias）
RECRUITMENT_AUTH_MODE=production

# 2. PostgreSQL 17 连接配置
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=recruitment_prod
PGUSER=recruitment
PGPASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
RECRUITMENT_DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# 3. 固定租户 ID（首次运行 0002 种子后的组织 UUID，或企业自建租户 UUID）
RECRUITMENT_TENANT_ID=00000000-0000-4000-8000-000000000001

# 4. 可选：邮箱收发（IMAP / SMTP，留空则界面诚实显示未配置）
# RECRUITMENT_MAIL_IMAP_HOST=
# RECRUITMENT_MAIL_SMTP_HOST=
# RECRUITMENT_MAIL_USER=
# RECRUITMENT_MAIL_PASS=

# 5. 可选：飞书日历与妙记连接器（留空则 fail-closed 降级）
# RECRUITMENT_FEISHU_USER_MAP=

# 6. 可选：离线私有真简历评测语料目录（仅用于本地/内网评测，不入库）
# RECRUITMENT_CORPUS_ROOT=/path/to/private-resumes
