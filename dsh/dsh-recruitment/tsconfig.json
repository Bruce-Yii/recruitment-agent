{
  "//": "客户端构建用的 TS 配置：只为 tsdown/oxc 提供 JSX 转换设置（react-jsx），不参与宿主代码执行。",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["react"]
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.tsx", "tsdown.config.ts"]
}
