{
  "step": 4,
  "id": "screening-evaluate",
  "label": "S7 screening_evaluate（只读、advisory、带逐准则证据）",
  "tool": {
    "name": "recruitment_screening_evaluate",
    "description": "S7 advisory screening evaluation for ONE application (read-only, advisory=true, never writes a decision). Reads the pinned material + rubric, runs the 7 human-queue/material blocking checks, evaluates the rubric criteria with three-state fields (present/absent/unreadable), and returns PASS | FAIL | NEEDS_REVIEW with page/bbox/sha256 evidence. Runs inside a read-only transaction. Errors are BLOCKED_BY_REVIEW / NO_RUBRIC / NOT_FOUND / INVALID_ARGS with reason_code.",
    "parameters": {
      "type": "object",
      "properties": {
        "application_id": {
          "type": "string",
          "description": "Application id (UUID). The evaluation target is an application, not a candidate x job pair."
        },
        "resume_version_id": {
          "type": "string",
          "description": "Optional material version override (UUID). Must belong to the same candidate as the application, otherwise INVALID_ARGS(RESUME_NOT_BELONG_TO_CANDIDATE)."
        },
        "rubric_version_id": {
          "type": "string",
          "description": "Optional rubric version override (UUID) = what_if. When it differs from the pinned version the output carries rubric.what_if=true and must not be used to write a decision."
        },
        "as_of": {
          "type": "string",
          "description": "ISO-8601 timestamp WITH timezone offset (e.g. 2026-11-13T00:00:00+08:00). Must not be later than the server clock. When omitted the output omits as_of (no wall-clock fields are ever emitted)."
        }
      },
      "required": [
        "application_id"
      ],
      "additionalProperties": false
    },
